;-------------------------------------------------------------------------------
; CLASSPAD config.bib: the image lives inside the translator's guest window,
; 0x8C100000-0x8CC7FFFF (dbt/Makefile owns these numbers). The last 4 KiB page
; (0x8CC7F000) is the debug ring shared with the translator, kept out of RAM.
;-------------------------------------------------------------------------------
MEMORY
;   Name        Start     Size      Type
;   -------     --------  --------  ----
    BOOTARGS    8C100000  00001000  RESERVED    ; OAL argument page (unused for now)
    NK          8C101000  00400000  RAMIMAGE    ; autosized by ROMIMAGE
    RAM         8C501000  0077E000  RAM         ; up to 0x8CC7F000
    DBGRING     8CC7F000  00001000  RESERVED    ; translator debug ring (image_cfg.h CLASSPAD_DBG_RING_PA)

CONFIG
    KERNELFIXUPS=ON
    AUTOSIZE=ON
    PROFILE=OFF
; @CESYSGEN IF !NK_NKNOCOMP
    COMPRESSION=ON
; @CESYSGEN ENDIF !NK_NKNOCOMP
; @CESYSGEN IF NK_NKNOCOMP
    COMPRESSION=OFF
; @CESYSGEN ENDIF NK_NKNOCOMP
    ROMFLAGS=00
