;-------------------------------------------------------------------------------
; CLASSPAD config.bib: two XIP regions in the NOR flash, both executed in place.
;   NK  83860000, 7.625 MiB: the eActivity area (chip 0x3860000-0x3FFFFFF),
;       where the translator boots it (dbt/Makefile NK_WINDOW=eact, NK_FLASH).
;       Casio's OS reformats that area at every boot that finds it holding
;       something else, so wince.hhk writes \fls0\NK.bin again after each
;       Casio session (docs/03).
;   EXT 80EE0000, 5 MiB: the erased hole inside Casio's 21 MiB OS image (chip
;       0x0EE0000-0x13E0000), which the OS never writes after an update: Math
;       Xpander and anything else that does not change with the BSP. The OAL
;       chains it to the kernel (OEMInit, classpad_extrom.h); wince.hhk writes
;       \fls0\EXT.bin there only when it differs (docs/03 "The EXT region").
; makeimg writes one .bin per region: NK.bin and EXT.bin. The translator, the
; flashers and the OAL hold the same addresses (dbt/Makefile NK_FLASH and
; EXT_FLASH, classpad_extrom.h). Until 2026-11-06 the repository built NK into
; the hole (81000000, 3.875 MiB), too small for the Standard Shell; the VM has
; used the eActivity area since 2026-11-05.
; RAM: the whole guest RAM window 0x8C000000-0x8C7FFFFF, 8 MiB (dbt/Makefile
; owns these numbers; briefly 0x8C000000-0x8CB4FFFF, 11.3 MiB, on 2026-11-06;
; 0x8C100000-0x8C8FFFFF from 2026-11-05; 11.5 MiB to 0x8CC7FFFF before) less
; its last 4 KiB page (0x8C7FF000), the debug ring shared with the translator.
;-------------------------------------------------------------------------------
MEMORY
;   Name        Start     Size      Type
;   -------     --------  --------  ----
    BOOTARGS    8C000000  00001000  RESERVED    ; OAL argument page (unused for now)
; The XIP regions in address order (romimage lays multiple regions out in the
; order they are listed: with NK first it built NK from 80EE0000, 2026-11-06).
    EXT         80EE0000  00500000  RAMIMAGE    ; the hole in Casio's OS image, 5 MiB (CLASSPAD_EXT_ROM_PA/_BYTES)
    NK          83860000  007A0000  RAMIMAGE    ; eActivity area, 7.625 MiB (RAMIMAGE is the only image type; XIP follows from the address)
    RAM         8C001000  007FE000  RAM         ; up to 0x8C7FF000 (dbt/Makefile GUEST_RAM_HI - 4 KiB)
    DBGRING     8C7FF000  00001000  RESERVED    ; translator debug ring (image_cfg.h CLASSPAD_DBG_RING_PA)

CONFIG
    KERNELFIXUPS=ON
; No autosizing: AUTOSIZE moves the start of RAM to the end of the image,
; which only fits RAM right behind a RAMIMAGE region. Here RAM is the SDRAM
; window and the images are in the NOR: with AUTOSIZE=ON (and
; DLLADDR_AUTOSIZE=ON, ROM_AUTOSIZE=OFF, RAM_AUTOSIZE=OFF) romimage put RAM at
; 8127B000, inside EXT, and stopped ("Ram start overlaps rom binary",
; 2026-11-06). The regions and RAM keep the sizes above; romimage gives the
; modules of both regions DLL addresses from its one range.
    AUTOSIZE=OFF
; ROMSTART/ROMSIZE only shape the .nb0 file (not used: the flashers take the
; .bin files); they cover NK, and romimage leaves EXT's records out of it.
    ROMSTART=83860000
    ROMSIZE=007A0000
    ROMWIDTH=32
; No compression: the writable sections are stored as is, so the kernel
; does not run its decompressor at boot (slow under the translator) and
; the image is a few hundred KB larger (the window has 8 MiB).
    COMPRESSION=OFF
    ROMFLAGS=00
; RAM file system (object store) share of RAM: 8 of 256 (3.1%, ~256 KiB of
; the 8 MiB window) in every 2 MiB band instead of the default 128 (50%).
; The kernel carves these pages at boot (loader.c CalcFSPages/CarveMem):
; unused ones are not given back to applications. The object store is the
; root file system and holds the registry, so it cannot be zero. With 9 MiB
; of RAM the default left ~90 free pages after the boot, and the kernel
; refused the display driver's data copy (AllocationExceedLowMemThreshold in
; InitModule), so GWES started without a driver (2026-11-03); 12.5%
; (20202020) until 2026-11-06.
    FSRAMPERCENT=08080808
