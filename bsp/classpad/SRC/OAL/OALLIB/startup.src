;;-----------------------------------------------------------------------------
;;  startup.src - CLASSPAD image entry
;;
;;  The translator loads NK.bin into RAM and jumps here with MD=1. Nothing
;;  board-level is needed (no SDRAM or watchdog setup: the calculator's own
;;  boot code and the translator's launcher already ran). KernelStart (nkldr)
;;  sets its own SR and turns the caches off.
;;-----------------------------------------------------------------------------
        .list       OFF
        .include    "kxshx.h"
        .list       ON

        .import     KernelStart

SR_INIT         .equ    h'500000F0      ; MD=1, BL=1, IMASK=15, RB=0
SYSINTR_NOP     .equ    0

        LEAF_ENTRY _StartUp

        mov.l   #SR_INIT, r0
        ldc     r0, sr
        mov.l   #h'00000000, r0
        ldc     r0, vbr                 ; the kernel installs its own table (shadowed by the translator)

        mov.l   #KernelStart, r0
        mov.l   #Base, r1
        sub     r1, r0
        mov.l   #4, r1
        sub     r1, r0
Base:   braf    r0
        nop

Halt:   bra     Halt
        nop

        ENTRY_END   _StartUp

;;-----------------------------------------------------------------------------
;;  OEMNMI - non-maskable interrupt: nothing to signal
;;-----------------------------------------------------------------------------
        LEAF_ENTRY _OEMNMI
        mov     #SYSINTR_NOP, r0
        rts
        nop
        ENTRY_END   _OEMNMI

        .end
