TARGETNAME=classpad_kbd
TARGETTYPE=DYNLINK
RELEASETYPE=PLATFORM
WINCEOEM=1
SYNCHRONIZE_DRAIN=1
DEFFILE=classpad_kbd.def
DLLENTRY=_DllMainCRTStartup
INCLUDES=$(INCLUDES);$(_TARGETPLATROOT)\src\inc
TARGETLIBS= \
    $(_COMMONSDKROOT)\lib\$(_CPUINDPATH)\coredll.lib
SOURCELIBS= \
    $(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\layoutmanager.lib \
    $(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\inputlang_0409.lib
SOURCES= \
    kbd_pdd.cpp \
    kbd_layout.cpp
