//
// classpad.cec - Platform Builder 5.0 catalog entry for PLATFORM\CLASSPAD
//
// Import once in Platform Builder: File > Manage Catalog Items > Import,
// pick this file. The New Platform Wizard then lists "Casio ClassPad: SH4"
// under BSPs. The drivers and applications are built with the BSP
// (SRC\dirs); they need no catalog items of their own, platform.bib takes
// them into the image when the OS design has GWES, the keyboard MDD, the
// touch (pointer) component, commctrl and commdlg (@CESYSGEN conditions).
//
CECInfo
(
    Name ( "classpad" )
    CECVersion ( 5.00 )
    Description ( "Casio ClassPad (SH7305 under the little-endian translator) BSP catalog items" )
    GUID ( {6A4F2C10-5C33-4A2B-9D0E-0C1A55E0C501} )
    Vendor ( "wince-classpad" )
)
