!if 0
classpad_usbms.dll - CE's USB mass storage function client with the SCSI
inquiry data filled in ("CASIO", "ClassPad WinCE"; usbms.cpp). The transport
is Platform Builder's library (usbmsfn_lib.lib, in PUBLIC: sysgen does not
copy it to the project); the SCSI emulation is compiled from
PUBLIC\COMMON\OAK\DRIVERS\USBFN\CLASS\STORAGE (the INCLUDES entries) by
usbms.cpp; the rest is what cesysgen links usbmsfn.dll with.
!endif

TARGETNAME=classpad_usbms
TARGETTYPE=DYNLINK
RELEASETYPE=PLATFORM
WINCEOEM=1
SYNCHRONIZE_DRAIN=1

DLLENTRY=DllEntry
DEFFILE=classpad_usbms.def

STORAGE_FN=$(_PUBLICROOT)\common\oak\drivers\usbfn\class\storage
INCLUDES=$(STORAGE_FN)\emulation\scsi2\block;$(STORAGE_FN)\emulation\scsi2\inc;$(STORAGE_FN)\inc;$(STORAGE_FN)\transport\inc;$(INCLUDES)

SOURCELIBS= \
    $(_PUBLICROOT)\common\oak\lib\$(_CPUINDPATH)\usbmsfn_lib.lib \
    $(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\ufnclientlib.lib \
    $(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\storeapi.lib

TARGETLIBS= \
    $(_COMMONSDKROOT)\lib\$(_CPUINDPATH)\coredll.lib \
    $(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\ceddk.lib

SOURCES= \
    usbms.cpp
