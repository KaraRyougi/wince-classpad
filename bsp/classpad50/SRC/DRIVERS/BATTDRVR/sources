!if 0
battdrvr.dll - the battery driver: the public MDD (battdrvr_lib.lib, sysgen'd
with the catalog's Battery Driver item, SYSGEN_BATTERY, which also puts the
battery API into coredll) plus the fx-CP400 PDD (battif.c: four AAA cells on
A/D channel AN2, Casio's own level thresholds, classpad_battery.h). The
library carries Microsoft's stub PDD (sbattif.obj) too; battif.c defines every
BatteryPDD* routine, so the linker never pulls it. Built under the public
name, so common.bib and common.reg load it and this copy replaces the stub
battdrvr.dll in the release directory.
!endif

TARGETNAME=battdrvr
TARGETTYPE=DYNLINK
RELEASETYPE=PLATFORM
WINCEOEM=1
SYNCHRONIZE_DRAIN=1

DLLENTRY=_DllMainCRTStartup
DEFFILE=$(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\battdrvr.def

INCLUDES=$(INCLUDES);$(_TARGETPLATROOT)\src\inc

SOURCELIBS= \
    $(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\battdrvr_lib.lib

TARGETLIBS= \
    $(_COMMONSDKROOT)\lib\$(_CPUINDPATH)\coredll.lib \
    $(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\ceddk.lib

SOURCES= \
    battif.c
