; SH3CRT.dll exports: coredll's floating-point names with the SH-3 calling
; convention (sh3crt.c). tools/sh3imports.py redirects SH-3 modules' imports
; of exactly these names here, by name.
LIBRARY SH3CRT
EXPORTS
    _adds=sh3_adds
    _subs=sh3_subs
    _muls=sh3_muls
    _divs=sh3_divs
    _negs=sh3_negs
    _eqs=sh3_eqs
    _nes=sh3_nes
    _lts=sh3_lts
    _les=sh3_les
    _gts=sh3_gts
    _ges=sh3_ges
    _itos=sh3_itos
    _utos=sh3_utos
    _stoi=sh3_stoi
    _stou=sh3_stou
    _addd=sh3_addd
    _subd=sh3_subd
    _muld=sh3_muld
    _divd=sh3_divd
    _negd=sh3_negd
    _eqd=sh3_eqd
    _ned=sh3_ned
    _ltd=sh3_ltd
    _led=sh3_led
    _gtd=sh3_gtd
    _ged=sh3_ged
    _dtoi=sh3_dtoi
    _dtou=sh3_dtou
    _dtos=sh3_dtos
    _stod=sh3_stod
    _itod=sh3_itod
    _utod=sh3_utod
    _i64tod=sh3_i64tod
    _ui64tod=sh3_ui64tod
    _dtoi64=sh3_dtoi64
    _dtoui64=sh3_dtoui64
    sin=sh3_sin
    cos=sh3_cos
    tan=sh3_tan
    asin=sh3_asin
    acos=sh3_acos
    atan=sh3_atan
    sinh=sh3_sinh
    cosh=sh3_cosh
    tanh=sh3_tanh
    exp=sh3_exp
    log=sh3_log
    log10=sh3_log10
    sqrt=sh3_sqrt
    floor=sh3_floor
    ceil=sh3_ceil
    fabs=sh3_fabs
    atan2=sh3_atan2
    pow=sh3_pow
    fmod=sh3_fmod
    _hypot=sh3__hypot
    _nextafter=sh3__nextafter
    atof=sh3_atof
    wcstod=sh3_wcstod
    _isnan=sh3__isnan
    _finite=sh3__finite
    _fpclass=sh3__fpclass
    SHHandleWMActivate=sh3_SHHandleWMActivate
