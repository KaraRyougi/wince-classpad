;;-----------------------------------------------------------------------------
;;  bench.src - the two timed loops of Xtune's benchmark, instruction for
;;  instruction (Xtune src/benchmark/tick_count.s and mem_bench.s, CalcLoverHK
;;  and Sentaro21), so that CEtune's CPU, ROM, RAM and I/O scores count the
;;  same thing as Ptune4's.
;;
;;  Both run until the long at the flag's address reads zero (another thread
;;  clears it) and return the number of passes in r0.
;;-----------------------------------------------------------------------------
        .section .text, code
        .export _tick_count
        .export _mem_bench

;;  DWORD tick_count(volatile DWORD *flag): r4 = flag
        .align  4
_tick_count:
        mov     #-1, r0
tl00:
        add     #1, r0
        mov.l   @r4, r3
        tst     r3, r3
        bf      tl00
        rts
        nop

;;  DWORD mem_bench(DWORD *area, volatile DWORD *flag): r4 = the address
;;  read, r5 = flag. One pass is 3 + 8 x 22 = 179 long reads of the address.
        .align  4
_mem_bench:
        mov     #-1, r0
ml00:
        add     #1, r0
        mov     #8, r7
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
ml02:
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1

        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1
        mov.l   @r4, r1

        mov.l   @r4, r1
        mov.l   @r4, r1

        dt      r7
        bf      ml02

        mov.l   @r5, r3
        tst     r3, r3
        bf      ml00
        rts
        nop

        .end
