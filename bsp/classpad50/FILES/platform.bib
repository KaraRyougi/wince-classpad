;-------------------------------------------------------------------------------
; CLASSPAD platform.bib (Windows CE 5.0): the display driver when GWES is in
; the OS design, the KEYSC keyboard with the keyboard MDD, the touch driver
; with the touch (pointer) component, the BSP's applications and the Pocket
; PC compatibility DLLs.
;
; Regions (config.bib, swapped 2026-11-09): everything this BSP builds (the
; drivers, Plotter-Z, PegHelp, the rotation programs, SH3CRT, DocList) is in
; NK with the OS, in the 5 MiB hole inside Casio's OS image that survives
; Casio boots, so the image is complete with NK.bin alone; Math Xpander and
; the libraries only it needs (mfcce300) live in EXT, the eActivity area,
; which Casio's OS reformats and wince.hhk reflashes when asked. Under CE 5.0
; the EXT entries below are taken out of ce.bib by PostFmergeBib.bat and
; built into EXT.bin by a second romimage run (PostRomImage.bat,
; ext.bib.hdr), so their region column must read exactly "EXT". Sizes,
; 2026-11-09 image before the swap: NK 4.88 MiB plus these 120 KiB of
; programs, EXT 4.0 MiB; the hole has 5 MiB.
;-------------------------------------------------------------------------------
MODULES
;;  Name            Path                                            Memory Type
;;  --------------- ----------------------------------------------- -----------
; @CESYSGEN IF CE_MODULES_DISPLAY
   classpad_ddi.dll     $(_FLATRELEASEDIR)\classpad_ddi.dll     NK  SH
; @CESYSGEN ENDIF CE_MODULES_DISPLAY
; @CESYSGEN IF CE_MODULES_KEYBD
   kbdmouse.dll         $(_FLATRELEASEDIR)\classpad_kbd.dll     NK  SH
; @CESYSGEN ENDIF CE_MODULES_KEYBD
; @CESYSGEN IF CE_MODULES_POINTER
   touch.dll            $(_FLATRELEASEDIR)\classpad_touch.dll   NK  SH
; @CESYSGEN ENDIF CE_MODULES_POINTER
; @CESYSGEN IF CE_MODULES_COMMCTRL
   DocList.dll          $(_FLATRELEASEDIR)\DocList.dll          NK   S
; @CESYSGEN ENDIF CE_MODULES_COMMCTRL

FILES

; Plotter-Z, a 3D function plotter (SRC\APPS\PLOTTERZ, built with the BSP):
; command bar, trackbar and the Open/Save dialogs, so only with commctrl and
; commdlg in the OS design. platform.dat puts the link in the Start menu.
; @CESYSGEN IF CE_MODULES_COMMCTRL
; @CESYSGEN IF CE_MODULES_COMMDLG
MODULES
    PlotterZ.exe        $(_FLATRELEASEDIR)\PlotterZ.exe        NK   S
; PegHelp.exe for the Help of Pocket PC programs (Math Xpander's Help button
; runs PegHelp.exe file:math1.htm#...): a viewer for the simple HTML of help
; files that needs only coredll (SRC\APPS\PEGHELP), instead of IE's htmlhelp.exe
    peghelp.exe         $(_FLATRELEASEDIR)\peghelp.exe         NK   S
FILES
    plotterz.lnk        $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\plotterz.lnk     NK   S
; @CESYSGEN ENDIF CE_MODULES_COMMDLG
; @CESYSGEN ENDIF CE_MODULES_COMMCTRL

MODULES
    classpad_rotate.exe $(_FLATRELEASEDIR)\classpad_rotate.exe NK  S

; The battery driver (SRC\DRIVERS\BATTDRVR; CE 5.0's common.bib has no entry
; for it, a BSP lists its own) and the status / battery type program
; (SRC\APPS\BATTERY)
MODULES
    battdrvr.dll        $(_FLATRELEASEDIR)\battdrvr.dll        NK  SH
    classpad_battery.exe $(_FLATRELEASEDIR)\classpad_battery.exe NK  S
FILES
    battery.lnk         $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\battery.lnk      NK   S

MODULES
    classpad_rotatekey.exe $(_FLATRELEASEDIR)\classpad_rotatekey.exe NK  S

; SH-3 floating point for the Pocket PC SH-3 binaries below (SRC\APPS\SH3CRT):
; coredll's helpers and double C functions with the SH-3 calling convention;
; stage.py points their imports here (tools/sh3imports.py).
MODULES
    sh3crt.dll          $(_FLATRELEASEDIR)\sh3crt.dll          NK   S

; MFC CE 3.0 (Pocket PC, SH3) for Math Xpander, with DocList.dll above (NK),
; executed in place from the EXT region. P: romimage does not check the CPU
; type of an SH3 module; the kernel loads ROM modules without a CPU check.
; The Pocket PC tools linked SH3 binaries with 1 KiB sections and romimage
; takes only 4 KiB ones ("only 4k page alignments supported"): stage.py
; realigns every MODULES entry under FILES with tools/pe4k.py.
MODULES
   mfcce300.dll          $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\legacy-mfc\mfcce300.dll        EXT  P

; Math Xpander 1.0 (Saltire, Pocket PC 2000 SH3) in the EXT region (config.bib):
; its binaries as XIP modules, help pages, keypad bitmaps and the Start menu
; link as files. The binaries are not in the repository: stage.py copies them
; into FILES\xpander from the unpacked cab (FILES\xpander\README.md) and
; realigns them to 4 KiB sections. MathXpander.exe is linked /FIXED (no
; relocations): stage.py rebuilds them first (pe4k.reconstruct_relocs; as a
; plain file CE 6 refused it, "not a valid Windows CE application": its loader
; takes no section that is not page aligned, 2026-11-06). The
; program is \Windows\MathXpander.exe; platform.dat puts the link in the Start
; menu, platform.reg registers .mwb. MathKeyPad.dll (its keypad input method)
; is in, not registered.
MODULES
   AlgebraicExpression.dll  $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\AlgebraicExpression.dll   EXT  P
   CalculationPane.dll      $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\CalculationPane.dll       EXT  P
   Common.dll               $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\Common.dll                EXT  P
   DataSet.dll              $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\DataSet.dll               EXT  P
   EvalAlgorithms.dll       $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\EvalAlgorithms.dll        EXT  P
   EventServiceBroker.dll   $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\EventServiceBroker.dll    EXT  P
   ExpressionEditor.dll     $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\ExpressionEditor.dll      EXT  P
   ExpressionEditorUI.dll   $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\ExpressionEditorUI.dll    EXT  P
   GeometryControl.dll      $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\GeometryControl.dll       EXT  P
   GeometryEngine.dll       $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\GeometryEngine.dll        EXT  P
   GeometryPane.dll         $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\GeometryPane.dll          EXT  P
   GraphFrame.dll           $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\GraphFrame.dll            EXT  P
   Graphics.dll             $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\Graphics.dll              EXT  P
   GraphicsPlane.dll        $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\GraphicsPlane.dll         EXT  P
   MfcComponents.dll        $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\MfcComponents.dll         EXT  P
   ndosspal.dll             $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\ndosspal.dll              EXT  P
   NumericCAS.dll           $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\NumericCAS.dll            EXT  P
   PlotControl.dll          $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\PlotControl.dll           EXT  P
   Relation.dll             $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\Relation.dll              EXT  P
   SymbolicPane.dll         $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\SymbolicPane.dll          EXT  P
   TableFrame.dll           $(_WINCEROOT)\PLATFORM\CLASSPAD\FILES\xpander\TableFrame.dll            EXT  P
