; Casio's storage memory as a read-only folder (SRC\DRIVERS\FUGUEDSK): needs
; FATFS in the OS design (classpad.bat SYSGEN_FATFS)
; @CESYSGEN IF CE_MODULES_FATFSD
MODULES
    fuguedsk.dll        $(_FLATRELEASEDIR)\fuguedsk.dll        NK  SH
