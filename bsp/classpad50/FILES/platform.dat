; CLASSPAD platform.dat: object store setup (initobj.dat) for the BSP

; Math Xpander from the EXT region (FILES\xpander, docs/03; the eActivity
; area since 2026-11-09): its Start menu link. The link and the program are in
; that region, so with no EXT region flashed there is nothing to copy.
Directory("\Windows\Programs"):-File("Math Xpander.lnk", "\Windows\mathxpander.lnk")

; SpreadCE from the EXT region (FILES\spreadce), like Math Xpander
Directory("\Windows\Programs"):-File("SpreadCE.lnk", "\Windows\spreadce.lnk")

; Plotter-Z (SRC\APPS\PLOTTERZ, in NK)
Directory("\Windows\Programs"):-File("Plotter-Z.lnk", "\Windows\plotterz.lnk")

; Battery status and type (SRC\APPS\BATTERY, in NK)
Directory("\Windows\Programs"):-File("Battery.lnk", "\Windows\battery.lnk")
; PPP over the USB serial port (SRC\APPS\USBNET, in NK)
Directory("\Windows\Programs"):-File("USB Network.lnk", "\Windows\usbnet.lnk")

; Help Contents (Start > Help): the viewer lists the shortcuts in \Windows\Help,
; named as Microsoft's wceshellfe.dat / wceappsfe.dat name them. WordPad's and
; Math Xpander's are in the EXT region with their pages.
Directory("\Windows"):-Directory("Help")
Directory("\Windows\Help"):-File("Windows CE Basics.lnk", "\Windows\wincehlp.lnk")
Directory("\Windows\Help"):-File("Remote Connections.lnk", "\Windows\rnetwhlp.lnk")
Directory("\Windows\Help"):-File("Settings.lnk", "\Windows\ctpnlhlp.lnk")
Directory("\Windows\Help"):-File("Copyright Information.lnk", "\Windows\copyrt.lnk")
Directory("\Windows\Help"):-File("WordPad.lnk", "\Windows\wordhlp.lnk")
Directory("\Windows\Help"):-File("Math Xpander.lnk", "\Windows\mathxpanderhlp.lnk")
