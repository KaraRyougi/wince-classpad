;-------------------------------------------------------------------------------
; CLASSPAD platform.reg
;-------------------------------------------------------------------------------
[HKEY_LOCAL_MACHINE\Platform]
   "Name"="Casio ClassPad (SH7305)"
   "Type"=dword:4

; Display: the GPE driver pushes a RAM frame buffer to the panel (SRC\DRIVERS\DISPLAY).
; 320x528 = fx-CP400, whose DCS panel the driver selects for a height of 500 rows
; or more ("Panel"=dword:1 would force it, dword:0 the fx-CG100 R61524 at
; 384x216 = 180 x D8). The touch driver reads the same height to find its panel.
; @CESYSGEN IF CE_MODULES_DISPLAY
[HKEY_LOCAL_MACHINE\System\GDI\Drivers]
    "Display"="classpad_ddi.dll"

;  GWES's glyph cache (the registry value is "Limit", read by gwes.exe at start).
; A recalculation in Plotter-Z repaints its whole window after every column,
; command bar included, and GWES was rasterising the menu text's glyphs through
; the TrueType scaler each time (28% of the recalculation's samples under the
; translator, 2026-11-09): the cache was too small for the menu bar, the
; taskbar clock and the program's own text together. 64 KiB instead of the
; default. Not yet measured on an image built with it.
[HKEY_LOCAL_MACHINE\SYSTEM\GDI\GLYPHCACHE]
    "Limit"=dword:10000

; Disable window and menu open/close animations: every animation frame forces
; intermediate GPE repaints and panel pushes under the translator.
[HKEY_LOCAL_MACHINE\SYSTEM\GWE]
    "Animate"=dword:0
[HKEY_LOCAL_MACHINE\SYSTEM\GWE\Menu]
    "AniType"=dword:0

[HKEY_LOCAL_MACHINE\Drivers\Display\ClassPad]
;   "Blit"=dword:1    ; the push: 1 = HC_LCD_PUSH by the translator (default), 2 = HC_LCD_BLIT with our window commands, 0 = translated stores
;   "Console"=dword:1 ; debug: leave the top 96 rows to the translator's panel console (rt/lcdcon.c), never push them
    "Width"=dword:140
    "Height"=dword:210

; @CESYSGEN ENDIF CE_MODULES_DISPLAY

; Keyboard: Layout Manager + KEYSC matrix PDD in kbdmouse.dll (SRC\DRIVERS\KEYBD).
; "Matrix" selects the key table: 1 = fx-CP400 keypad (the target), 0 = fx-CG100
; keypad (casio-emu's fx-cg100 profile). "PollMs" is the input tick in ms (matrix
; scan, and the touch driver's contact poll), "Priority256" its thread's priority.
; @CESYSGEN IF CE_MODULES_KEYBD
[HKEY_LOCAL_MACHINE\HARDWARE\DEVICEMAP\KEYBD]
    "DriverName"="kbdmouse.dll"
    "Matrix"=dword:1
    "PollMs"=dword:8
    "Priority256"=dword:91

; the device layout of the "ClassPad" PDD and the US layout live in the same DLL
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Layouts\00000409]
    "Layout File"="kbdmouse.dll"
    "Layout Text"="US"
    "ClassPad"="kbdmouse.dll"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Layouts\e0010409]
    "Keyboard Layout"="00000409"

[HKEY_CURRENT_USER\Keyboard Layout\Preload]
    @="00000409"

[HKEY_CURRENT_USER\Keyboard Layout\Preload\1]
    @="00000409"
; @CESYSGEN ENDIF CE_MODULES_KEYBD

; Touch: touch MDD + the IIC0 sensor DDSI in touch.dll (SRC\DRIVERS\TOUCH).
; "Panel": 1 = fx-CP400 sensor present, 0 = none; absent = decided by the
; display height (528 rows = fx-CP400). CalibrationData: the raw sensor
; values of the MDD's five calibration points (centre, then the four
; corners inset by a tenth) for the 320x528 screen, from casio-emu's stylus
; mapping raw = 0x20B + x*0x9B6/256, 0xF4 + y*0x66F/256 (classpad_touch.h).
; @CESYSGEN IF CE_MODULES_POINTER
[HKEY_LOCAL_MACHINE\HARDWARE\DEVICEMAP\TOUCH]
    "DriverName"="touch.dll"
    "MaxCalError"=dword:7
    "CalibrationData"="2076,1942 833,578 833,3306 3319,3306 3319,578 "
; @CESYSGEN ENDIF CE_MODULES_POINTER

; Power Manager: 60 s UserIdle, another 60 s SystemIdle (display off),
; then 180 s without system activity before retained-RAM suspend.
; The OAL arms only Clear/ON for full suspend. Display-idle alone can still
; be cancelled by ordinary user input through the standard PM policy.
; @CESYSGEN IF CE_MODULES_PM
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\Timeouts]
    "ACUserIdle"=dword:3c
    "ACSystemIdle"=dword:3c
    "ACSuspend"=dword:b4
    "BattUserIdle"=dword:3c
    "BattSystemIdle"=dword:3c
    "BattSuspend"=dword:b4
; @CESYSGEN ENDIF CE_MODULES_PM

; Handle the touch-strip icons (Rotate, Menu, Main, Esc, Settings) and the
; fx-CP400 Keyboard key outside GWES.
[HKEY_LOCAL_MACHINE\init]
    "Launch94"="classpad_rotatekey.exe"
    "Depend94"=hex:14,00,1e,00,32,00

; Math Xpander's math keyboard as a SIP input method, what its DllRegisterServer
; writes (the cab ran regsvrce.exe on it). The fx-CP400 Keyboard key shows it
; (classpad_rotatekey.exe); the SIP is softkb.dll.
[HKEY_CLASSES_ROOT\CLSID\{D8183B68-05D1-11d4-80D9-001083023057}]
    @="MathKeyPad"
[HKEY_CLASSES_ROOT\CLSID\{D8183B68-05D1-11d4-80D9-001083023057}\InprocServer32]
    @="\\Windows\\MathKeyPad.dll"
[HKEY_CLASSES_ROOT\CLSID\{D8183B68-05D1-11d4-80D9-001083023057}\IsSIPInputMethod]
    @="1"
[HKEY_CLASSES_ROOT\CLSID\{D8183B68-05D1-11d4-80D9-001083023057}\DefaultIcon]
    @="\\Windows\\MathKeyPad.dll,0"

; Math Xpander workbooks (.mwb), as its Pocket PC cab registers them, with the
; program at its ROM path in the EXT region (FILES\xpander).
[HKEY_CLASSES_ROOT\.mwb]
    @="isce_mwbfile"
[HKEY_CLASSES_ROOT\isce_mwbfile]
    @="Math Xpander Workbook"
[HKEY_CLASSES_ROOT\isce_mwbfile\DefaultIcon]
    @="\\Windows\\MathXpander.exe,0"
[HKEY_CLASSES_ROOT\isce_mwbfile\Shell\Open\Command]
    @="\"\\Windows\\MathXpander.exe\" %1"

; Battery (SRC\DRIVERS\BATTDRVR, the catalog's Battery Driver item loads it):
; the cells in the calculator, as Casio's "Battery Settings" asks. Type 0 =
; alkaline, 1 = Ni-MH: Casio's two threshold sets (classpad_battery.h).
; MilliVoltsPerCount: pack millivolts per A/D count, 10 inferred from those
; thresholds; correct it here if a meter says otherwise.
; What the public battdrvr.reg holds (a BSP includes it; here spelled out): the
; API-ready event and the driver's device manager entry. Flags 8 =
; DEVFLAGS_NAKEDENTRIES (Init, not BAT_Init); the IClass is battery.h's
; BATTERY_DRIVER_CLASS.
[HKEY_LOCAL_MACHINE\System\Events]
    "SYSTEM/BatteryAPIsReady"="Battery Interface APIs"
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\Battery]
    "Prefix"="BAT"
    "Dll"="battdrvr.dll"
    "Flags"=dword:8
    "Order"=dword:0
    "PollInterval"=dword:7530
    "IClass"="{DD176277-CD34-4980-91EE-67DBEF3D8913}"

[HKEY_LOCAL_MACHINE\Software\ClassPad\Battery]
    "Type"=dword:0
    "MilliVoltsPerCount"=dword:A

; Backlight level: the "Advanced..." button of Control Panel > Display >
; Backlight opens classpad_bkl.dll (SRC\APPS\BKLCPL), which sets the level in
; the display driver (SRC\INC\classpad_bkl.h).
[HKEY_CURRENT_USER\ControlPanel\BackLight]
    "AdvancedCPL"="classpad_bkl.dll"

; No sound, on purpose. The image has no wave API (waveapi.dll), no audio
; driver, no ACM codecs, no .wav files and no Sounds control panel, so
; nothing can play; these values tell GWES and the notification engine not
; to try either: no key clicks, no screen-tap clicks, every sound category
; off (Mute: 1 notifications, 2 applications, 4 events), volume 0.
[HKEY_CURRENT_USER\ControlPanel\Volume]
    "Key"=dword:0
    "Screen"=dword:0
    "Mute"=dword:0
    "Volume"=dword:0

; Casio's storage memory (\fls0) as a folder (SRC\DRIVERS\FUGUEDSK):
; the block driver, loaded by the device manager and announced to the Storage
; Manager through the block driver class; MSPART finds the FAT16 partition in
; the volume's MBR (type 0E -> FATFS in common.reg's PartitionTable) and FATFS
; mounts it under the profile's Folder. Ioctl 4 = DISK_IOCTL_INITIALIZED
; after Init. No volume in the flash: Init fails and there is no folder.
; Writable = 0 keeps the volume read-only (the driver then reports the device
; read-only, which is what makes FATFS mount it so); with 1 it is written
; when the translator can program the flash and the volume is one Casio's OS
; formatted (fuguedsk.c).
; @CESYSGEN IF CE_MODULES_FATFSD
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\ClassPadStorage]
    "Dll"="fuguedsk.dll"
    "Prefix"="DSK"
    "Order"=dword:2
    "Ioctl"=dword:4
    "Profile"="ClassPadStorage"
    "Writable"=dword:1
    "IClass"="{A4E7EDDA-E575-4252-9D6B-4195D48BB865}"
[HKEY_LOCAL_MACHINE\System\StorageManager\Profiles\ClassPadStorage]
    "Name"="Casio storage memory"
    "Folder"="Storage"
; @CESYSGEN ENDIF CE_MODULES_FATFSD

; USB function (SRC\DRIVERS\USBFN): the controller driver, a bus driver that
; loads one function client, DefaultClientDriver, from the keys below.
; CablePin = 1: the controller is powered only while Port U bit 1 says a
; cable is in (0: powered all the time, by VBUS alone).
;   Mass_Storage_Class  classpad_usbms.dll (usbmsfn with the inquiry data
;                       "CASIO" / "ClassPad WinCE"): Casio's storage memory (DSK1:, the
;                       FUGUEDSK disk) as a USB drive. While a host has it,
;                       CE's own \Storage folder is dismounted; it comes
;                       back when the cable goes (usbmsfn does both).
;   CDC_ACM             classpad_usbacm.dll: a serial port (COM) the host
;                       sees as a CDC ACM modem, for PPP or a terminal.
; Control Panel > USB Connection (classpad_usb.cpl) changes the client at run time and the default for
; the next boot. The vendor and product numbers are pid.codes' test numbers
; (1209:0001/0002), for private use only: replace them before giving an
; image to anyone.
; @CESYSGEN IF CE_MODULES_USBFN
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\ClassPadUsbFn]
    "Dll"="classpad_usbfn.dll"
    "Prefix"="UFN"
    "Order"=dword:20
    "Priority256"=dword:64
    "CablePin"=dword:1
    "BusIoctl"=dword:2a0048
    "IClass"=multi_sz:"{E2BDC372-598F-4619-BC50-54B3F7848D35}=%b","{6F40791D-300E-44E4-BC38-E0E63CA8375C}=%b"

[HKEY_LOCAL_MACHINE\Drivers\USB\FunctionDrivers]
    "DefaultClientDriver"=- ; whatever common.reg chose
[HKEY_LOCAL_MACHINE\Drivers\USB\FunctionDrivers]
    "DefaultClientDriver"="Mass_Storage_Class"

[HKEY_LOCAL_MACHINE\Drivers\USB\FunctionDrivers\Mass_Storage_Class]
    "Dll"="classpad_usbms.dll"
    "InterfaceSubClass"=dword:06
    "InterfaceProtocol"=dword:50
    "DeviceName"="DSK1:"
    "Removable"=dword:1
    "FriendlyName"="Mass Storage Device"
    "idVendor"=dword:1209
    "Manufacturer"="CASIO"
    "idProduct"=dword:0001
    "Product"="ClassPad WinCE"
    "bcdDevice"=dword:0

[HKEY_LOCAL_MACHINE\Drivers\USB\FunctionDrivers\CDC_ACM]
    "Dll"="classpad_usbacm.dll"
    "DeviceName"="USBFNS1:"
    "Prefix"="COM"
    "DeviceArrayIndex"=dword:0
    "DeviceType"=dword:0
    "Tsp"="Unimodem.dll"
    "IClass"="{CC5195AC-BA49-48a0-BE17-DF6D1B0173DD}"
    "FriendlyName"="USB Serial Port"
    "idVendor"=dword:1209
    "Manufacturer"="CASIO"
    "idProduct"=dword:0002
    "Product"="ClassPad WinCE"
    "bcdDevice"=dword:0
; @CESYSGEN ENDIF CE_MODULES_USBFN

; Telnet server (classpad.bat SYSGEN_TELNETD): without a log-on, and not
; loaded at boot. With IsEnabled 0 services.exe drops the server again when
; it goes through its list; USB Network (usbnet.cpp) loads it while the PPP
; link over the USB cable is there, the only way in.
[HKEY_LOCAL_MACHINE\COMM\TELNETD]
    "IsEnabled"=dword:0
    "UseAuthentication"=dword:0
