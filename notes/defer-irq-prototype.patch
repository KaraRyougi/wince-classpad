+/* ------------------------------------------------- deferred interrupts
+ * -DDBT_DEFER_IRQ (prototype). An interrupt that arrives inside a block (or
+ * in a helper stub the block called) is not delivered there, which needs the
+ * block's recovery metadata to rebuild the guest state. Instead the block
+ * runs on to its exit with SR.IMASK = 15, and its exits are made to trap:
+ * links unchained, the inline cache emptied, and the pool literals that
+ * hold the lookup stubs' addresses pointed at dbt_defer_stubs. The trap
+ * (defer_deliver) puts the literals and the interrupt mask back and resumes
+ * at the real lookup stub, where the pending interrupt is taken with the
+ * guest state canonical (resume = X0, no metadata). Any other exception
+ * that reaches the guest first cancels the deferral (defer_cancel): the
+ * interrupt request is still asserted and fires when the guest unmasks.
+ * Not deferred (delivered at once, as before): blocks that touch SR
+ * (dbt_block.no_defer), an interrupt inside a link's patch window or the
+ * inline-cache sequence, block entries and exit stubs (no metadata needed). */
+#ifdef DBT_DEFER_IRQ
+extern char dbt_defer_stubs[], dbt_defer_stubs_end[];
+#define DEFER_LITS 8
+static struct {
+    int pending;
+    dbt_block *block;
+    sf_u32 orig_imask;
+    sf_u32 intevt, expevt, tra;         /* INTEVT of the deferred interrupt; EXPEVT/TRA as the guest last saw them */
+    sf_u32 lit[DEFER_LITS], old[DEFER_LITS];
+    int nlit;
+} g_defer;
+
+static void defer_unpatch(void)
+{
+    int i;
+    for (i = 0; i < g_defer.nlit; i++) *(volatile sf_u32 *)g_defer.lit[i] = g_defer.old[i];
+    g_defer.nlit = 0; g_defer.block = 0;
+}
+
+static int defer_patch(dbt_block *b)
+{
+    sf_u32 a, hi = b->host_base + (sf_u32)b->host_len;
+    int k;
+    for (k = 0; k < b->nlinks; k++) unchain(b, k);
+    if (b->ic_off >= 0) reset_ic(b);
+    g_defer.nlit = 0; g_defer.block = b;
+#ifdef DBT_SECOND_CHANCE
+    a = b->host_base + reloc_pool(reloc_rec(b));
+#else
+    a = (b->host_base + (sf_u32)b->code_len + 3u) & ~3u;
+#endif
+    for (; a + 4 <= hi; a += 4) {
+        sf_u32 v = *(volatile sf_u32 *)a, n = 0;
+        if (v == (sf_u32)dbt_lookup_link) n = (sf_u32)dbt_defer_stubs;
+        else if (v == (sf_u32)dbt_lookup_ic) n = (sf_u32)dbt_defer_stubs + 2;
+        if (!n) continue;
+        if (g_defer.nlit == DEFER_LITS) { defer_unpatch(); return 0; }
+        g_defer.lit[g_defer.nlit] = a; g_defer.old[g_defer.nlit] = v; ++g_defer.nlit;
+        *(volatile sf_u32 *)a = n;
+    }
+    if (!g_defer.nlit) { g_defer.block = 0; return 0; }     /* no exit we can catch */
+    return 1;
+}
+
+/* An exception is about to be delivered to the guest while a deferral is
+ * pending: give the guest its real interrupt mask and forget the deferral. */
+static void defer_cancel(dbt_gctx *ctx)
+{
+    defer_unpatch();
+    ctx->ssr = (ctx->ssr & ~SR_IMASK) | g_defer.orig_imask;
+    g_defer.pending = 0;
+    ++g_df_cancelled;
+}
+
+/* The trap of a deferred block's exit: the context becomes that of the
+ * deferred interrupt taken at the first instruction of the real lookup stub
+ * (guest state canonical, resume = X0), which the caller then delivers.
+ * Waiting for the request to fire again after unmasking is not enough: it
+ * need not be accepted before the stub and the next block have run, and
+ * would then be deferred once more (tmu guest, 2026-11-10). The trap's own
+ * EXPEVT and TRA are replaced by the values the guest last saw. */
+static void defer_deliver(dbt_gctx *ctx)
+{
+    unsigned k = (unsigned)(ctx->host_spc - 2 - (sf_u32)dbt_defer_stubs) / 2;
+    if (!g_defer.pending) dbt_halt("deferred-interrupt trap with nothing pending");
+    defer_unpatch();
+    ctx->ssr = (ctx->ssr & ~SR_IMASK) | g_defer.orig_imask;
+    ctx->host_spc = k ? (sf_u32)dbt_lookup_ic : (sf_u32)dbt_lookup_link;
+    ctx->vec_off = 0x600; ctx->intevt = g_defer.intevt;
+    ctx->expevt = g_defer.expevt; ctx->tra = g_defer.tra;
+    EXPEVT_REG = g_defer.expevt; TRA_REG = g_defer.tra;
+    g_defer.pending = 0;
+    ++g_df_delivered;
+}
+
+/* Interrupt at ctx->host_spc: 1 = deferred (resume where it was, masked). */
+static int defer_try(dbt_gctx *ctx)
+{
+    sf_u32 spc = ctx->host_spc, host, off;
+    dbt_block *b;
+    int k;
+    if (IN(spc, dbt_stubs_start, dbt_stubs_end)) {
+        if (IN(spc, dbt_full_m1, dbt_full_end)) host = ctx->r[1];           /* about to jump to r1 */
+        else if (IN(spc, dbt_fpu_stub, dbt_hfpu_masked) || IN(spc, dbt_fallback_stub, dbt_hfb_masked) ||
+                 IN(spc, dbt_ldc_sr_stub, dbt_hsr_masked)) host = ctx->slots[SLOT_X1];   /* helper prologue: returns to X1 */
+        else return 0;
+    } else host = spc;
+    b = block_of_host(host);
+    if (!b || g_binfo[b - g_blocks].dead) return 0;
+    off = host - b->host_base;
+    if (off == 0) { ++g_df_entry; return 0; }               /* block entry: the precise path needs no metadata */
+    if (off >= (sf_u32)b->code_len) return 0;               /* exit stub: resolved from the link */
+    if (b->no_defer) { ++g_df_unsafe; return 0; }
+    for (k = 0; k < b->nlinks; k++) {
+        sf_u32 j = b->links[k].jump_off;
+        if (off + 2 >= j && off < j + 10) { ++g_df_window; return 0; }     /* inside words that unchain rewrites */
+    }
+    if (b->ic_off >= 0 && off + 48 >= (sf_u32)b->code_len) { ++g_df_window; return 0; }   /* inside the inline-cache sequence */
+    if (g_defer.block != b) {
+        if (g_defer.block) defer_unpatch();
+        if (!defer_patch(b)) {
+            ++g_df_nopatch;
+            if (g_defer.pending) { ctx->ssr = (ctx->ssr & ~SR_IMASK) | g_defer.orig_imask; g_defer.pending = 0; }
+            return 0;
+        }
+    }
+    if (!g_defer.pending) {
+        g_defer.orig_imask = ctx->ssr & SR_IMASK; g_defer.expevt = ctx->expevt; g_defer.tra = ctx->tra;
+        g_defer.pending = 1; ++g_df_deferred;
+    } else ++g_df_again;
+    g_defer.intevt = ctx->intevt;
+    ctx->ssr |= SR_IMASK;
+    return 1;
+}
+#endif
