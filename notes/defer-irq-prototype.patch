+/* Instructions that see or change SR, SSR, SPC or the banked registers, or
+ * that leave the block through an exception or the power state: a block
+ * holding one is not run on with interrupts masked (rt.c DBT_DEFER_IRQ). */
+static int defer_unsafe_op(unsigned op)
+{
+    unsigned form = op & 0xF00Fu, cr = (op >> 4) & 0xFu;
+    if (op == 0x002Bu || op == 0x001Bu || op == 0x0038u) return 1;      /* rte, sleep, ldtlb */
+    if ((op & 0xFF00u) == 0xC300u) return 1;                            /* trapa */
+    if ((form == 0x0002u || form == 0x4003u || form == 0x400Eu || form == 0x4007u) && cr != 1) return 1;   /* stc/ldc except GBR */
+    return 0;
+}
